# Copy to .env (never commit .env). Used only by `npm run test:integration`.
# The Entra app needs the SharePoint "Sites.FullControl.All" or "Sites.Selected" application
# permission and a certificate. The tests only create, change and delete content inside a new
# "__pnp-test-<timestamp>" folder in the test library, and delete that folder at the end.
SP_TENANT_ID=00000000-0000-0000-0000-000000000000
SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
SP_SUBDOMAIN=contoso
SP_PRIVATE_KEY_PATH=./certs/private-key.pem
SP_PRIVATE_KEY_PASSPHRASE=
# Use the certificate PEM or the thumbprint
SP_CERTIFICATE_PATH=./certs/certificate.pem
SP_CERTIFICATE_THUMBPRINT=
SP_SITE_URL=https://contoso.sharepoint.com/sites/Example
# Site-relative path of the document library root folder
SP_TEST_LIBRARY_PATH=Shared Documents
# Optional. A public HTTPS URL that answers the webhook validation request: it must return the
# "validationtoken" query parameter as text/plain with status 200. Without it, the webhook
# subscription tests that need SharePoint to create a subscription are skipped.
SP_WEBHOOK_NOTIFICATION_URL=
# Optional. true runs the write tests that change the site, lists, fields, content types, settings
# or the term store. Use it only on a site that you can change and reset, never on a production site.
SP_RUN_WRITE_TESTS=false
