{
	"name": "n8n-nodes-sharepoint-pnp",
	"version": "0.1.0",
	"description": "n8n community nodes for advanced SharePoint operations through the SharePoint REST API, built on PnPjs",
	"license": "MIT",
	"homepage": "https://github.com/octanesoftware/n8n-nodes-sharepoint-pnp",
	"keywords": [
		"n8n-community-node-package",
		"sharepoint",
		"pnpjs",
		"microsoft"
	],
	"author": {
		"name": "Octane Software",
		"email": "fisher1987@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octanesoftware/n8n-nodes-sharepoint-pnp.git"
	},
	"scripts": {
		"build": "n8n-node build && node scripts/bundle.mjs",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.mts",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SharePointPnpOAuth2Api.credentials.js",
			"dist/credentials/SharePointPnpCertificateApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SharePointPnp/SharePointPnp.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.5",
		"@pnp/core": "^4.22.0",
		"@pnp/queryable": "^4.22.0",
		"@pnp/sp": "^4.22.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.32.0",
		"n8n-workflow": "^2.46.5",
		"prettier": "^3.6.2",
		"release-it": "^21.1.2",
		"typescript": "^5.9.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
